---
const { content } = Astro.props;
const trustKeys = ['trust_points_1', 'trust_points_2', 'trust_points_3'];
const icons = [
  { bg: 'bg-blue-100', text: 'text-blue-600', path: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },   // shield-check
  { bg: 'bg-green-100', text: 'text-green-600', path: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' }, // badge-check
  { bg: 'bg-amber-100', text: 'text-amber-600', path: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z' } // star
];
const trustItems = trustKeys.map((key, i) => {
  if (content[key]) {
    const [title, desc] = content[key].split('::');
    return { title, desc, icon: icons[i] };
  }
  return null;
}).filter(Boolean);
---
<section id="trusted" class="py-20 bg-gray-50">
  <div class="container mx-auto px-4 text-center">
    <span class="text-blue-600 font-semibold text-sm uppercase tracking-wide">Kenapa Memilih Kami</span>
    <h2 class="text-3xl md:text-4xl font-bold mt-2 mb-12 text-gray-800">Alasan Ribuan Keluarga Percaya Kami</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {trustItems.map(item => (
        <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border border-gray-100">
          <div class={`w-14 h-14 ${item.icon.bg} ${item.icon.text} rounded-2xl flex items-center justify-center mx-auto mb-5`}>
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon.path} />
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3 text-gray-800">{item.title}</h3>
          <p class="text-gray-600 leading-relaxed text-sm">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
