---
import { formatRupiah, buildWaLink } from '../lib/format.js';

const { content = {}, heroImageResult, availableUnits, totalUnits } = Astro.props || {};

// Safe helpers — jangan melempar jika ada masalah dengan helpers eksternal
function safeFormatRupiah(value) {
  try {
    if (value === null || value === undefined || value === '') return '-';
    return formatRupiah(value);
  } catch (e) {
    return typeof value === 'number' ? value.toLocaleString('id-ID') : String(value || '-');
  }
}
function safeBuildWaLink(number, message) {
  try {
    return buildWaLink(number, message);
  } catch (e) {
    // fallback simple wa link
    const num = number ? String(number).replace(/[^0-9+]/g, '') : '';
    const text = encodeURIComponent(message || 'Saya tertarik');
    return num ? `https://wa.me/${num}?text=${text}` : `https://wa.me/?text=${text}`;
  }
}

const title = content.hero_title || '';
const subtitle = content.hero_subtitle || '';
const badgeText = content.badge_text || '';
const cluster = content.cluster_name || '';
const priceFrom = content.price_from || content.price || '';
const promoDp = content.promo_dp || '';
const promoBooking = content.promo_booking || '';
const features = [
  content.total_unit ? `${content.total_unit} Unit` : null,
  content.jumlah_lantai ? `${content.jumlah_lantai} Lantai` : null,
  content.jarak_lrt || null,
  content.jarak_tol || null
].filter(Boolean);

const waMessage = `Halo, saya tertarik dengan ${title || 'properti ini'}. Boleh info lebih lanjut?`;
const waLink = safeBuildWaLink(content.whatsapp_number, waMessage);

// fallback image jika heroImageResult tidak tersedia
const fallbackHero = '/assets/placeholder-hero.jpg';
const heroSrc = heroImageResult?.src || fallbackHero;
const heroSrcSet = heroImageResult?.srcSet?.attribute || undefined;
---

<section class="hero">
  <img
    src={heroSrc}
    srcset={heroSrcSet}
    sizes="100vw"
    alt={title || 'Foto cluster'}
    loading="eager"
    fetchpriority="high"
    class="hero-bg"
  />

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-content">
    {badgeText && <span class="hero-badge">{badgeText}</span>}

    {typeof availableUnits === 'number' && (
      <div class="scarcity-badge">
        🔥 Tersisa <strong>{availableUnits}</strong> dari {totalUnits || content.total_unit || '-'} unit!
      </div>
    )}

    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}

    <div class="hero-price-card" role="region" aria-label="Harga mulai">
      <span class="hero-price-label">Harga mulai</span>
      <span class="hero-price">{safeFormatRupiah(priceFrom)}</span>
      <div class="hero-promo">
        {promoDp && <span class="promo-chip">{promoDp}</span>}
        {promoBooking && <span class="promo-chip">{promoBooking}</span>}
      </div>
    </div>

    <div class="hero-stats" aria-hidden={features.length === 0}>
      {features.map((f) => (
        <div class="stat"><strong>{f}</strong></div>
      ))}
    </div>

    <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa" aria-label="Booking via WhatsApp">
      Booking via WhatsApp
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-primary);
  }
  .hero-bg,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-bg { filter: brightness(0.78) saturate(0.95); }
  .hero-overlay {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-primary) 92%, transparent) 0%,
      color-mix(in srgb, var(--color-primary) 55%, transparent) 45%,
      color-mix(in srgb, var(--color-primary) 15%, transparent) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 1;
    color: var(--color-bg-main);
    padding-block: var(--space-xl) var(--space-lg);
  }
  .hero-badge {
    display: inline-block;
    background: var(--color-secondary);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: var(--space-sm);
  }
  .scarcity-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-scarcity);
    color: var(--color-bg-main);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 8px 18px;
    border-radius: 999px;
    margin-bottom: var(--space-sm);
    animation: pulse-scarcity 2s ease-in-out infinite;
  }
  @keyframes pulse-scarcity {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-scarcity) 40%, transparent); }
    50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-scarcity) 0%, transparent); }
  }
  .hero-title {
    font-size: clamp(2.2rem, 6vw, 4rem);
    margin-bottom: var(--space-xs);
    max-width: 20ch;
    font-family: var(--font-display);
  }
  .hero-subtitle {
    font-size: 1.15rem;
    color: color-mix(in srgb, var(--color-bg-main) 85%, transparent);
    margin-bottom: var(--space-md);
  }
  .hero-price-card {
    background: var(--color-bg-main);
    color: var(--color-primary);
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    margin-bottom: var(--space-md);
  }
  .hero-price-label {
    font-size: 0.8rem;
    color: var(--color-navy-soft);
  }
  .hero-price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .hero-promo {
    display: flex;
    gap: 8px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .promo-chip {
    background: var(--color-gold-soft);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .stat {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-bg-main) 85%, transparent);
  }
  .stat strong {
    font-size: 1.1rem;
    color: var(--color-bg-main);
  }
  .btn-wa {
    display: inline-block;
    background: var(--color-secondary);
    color: var(--color-primary);
    font-weight: 600;
    padding: 14px 32px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: transform 0.15s ease;
  }
  .btn-wa:hover {
    transform: translateY(-2px);
  }
</style>
