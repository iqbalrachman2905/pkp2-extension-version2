---
const { content } = Astro.props;
const faqKeys = Object.keys(content).filter(key => key.startsWith('faq_home_'));
const faqs = faqKeys.map(key => {
  const [question, answer] = content[key].split('::');
  return { question, answer };
}).filter(item => item.question && item.answer);

// Split jadi 2 kolom: kolom kiri baca top-down dulu, baru kolom kanan
// (bukan zigzag), biar natural dibaca urut kayak numbering aslinya.
const half = Math.ceil(faqs.length / 2);
const colLeft = faqs.slice(0, half);
const colRight = faqs.slice(half);
---
<section id="faq-home" class="py-20 bg-[#F8FAFC]">
  <div class="container mx-auto px-4 max-w-5xl">

    <div class="text-center mb-14">
      <span class="text-xs md:text-sm font-bold tracking-widest text-[#D4AF37] uppercase mb-3 block">Bantuan</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">Pertanyaan Seputar PKP2</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 items-start">
      <div class="space-y-4">
        {colLeft.map((faq) => (
          <details class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-300 hover:shadow-md">
            <summary class="flex justify-between items-center font-bold cursor-pointer p-6 text-gray-800 hover:text-[#D4AF37] transition-colors focus:outline-none">
              <span class="text-base md:text-lg pr-4">{faq.question}</span>
              <span class="transition-transform duration-300 group-open:rotate-180 flex-shrink-0 text-[#D4AF37] bg-yellow-50 p-2 rounded-full">
                <svg fill="none" height="20" width="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 pt-1 text-gray-600 text-sm md:text-base leading-relaxed">
              <div class="pt-4 border-t border-gray-50">
                {faq.answer}
              </div>
            </div>
          </details>
        ))}
      </div>

      <div class="space-y-4">
        {colRight.map((faq) => (
          <details class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-300 hover:shadow-md">
            <summary class="flex justify-between items-center font-bold cursor-pointer p-6 text-gray-800 hover:text-[#D4AF37] transition-colors focus:outline-none">
              <span class="text-base md:text-lg pr-4">{faq.question}</span>
              <span class="transition-transform duration-300 group-open:rotate-180 flex-shrink-0 text-[#D4AF37] bg-yellow-50 p-2 rounded-full">
                <svg fill="none" height="20" width="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 pt-1 text-gray-600 text-sm md:text-base leading-relaxed">
              <div class="pt-4 border-t border-gray-50">
                {faq.answer}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>

  </div>
</section>
<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
