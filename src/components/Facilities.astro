---
const { gallery } = Astro.props;
const facilities = gallery.filter(item => item.kategori === 'facility' && item.thumbnail_url);
---
<section id="fasilitas" class="py-20 bg-white">
  <div class="container mx-auto px-4 text-center">
    <span class="text-blue-600 font-semibold text-sm uppercase tracking-wide">Fasilitas</span>
    <h2 class="text-3xl md:text-4xl font-bold mt-2 mb-12 text-gray-800">Fasilitas Premium untuk Keluarga</h2>

    {facilities.length > 0 ? (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {facilities.map(item => (
          <div class="group relative overflow-hidden rounded-2xl shadow-sm aspect-square">
            <img
              src={item.thumbnail_url}
              alt={item.caption || 'Fasilitas'}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-black/0 opacity-80 group-hover:opacity-90 transition-opacity"></div>
            <div class="absolute bottom-0 left-0 w-full p-4 text-left">
              <p class="text-white font-semibold text-sm md:text-base drop-shadow">{item.caption}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-gray-400">Fasilitas belum tersedia (cek sheet Gallery, kategori "facility")</p>
    )}
  </div>
</section>
