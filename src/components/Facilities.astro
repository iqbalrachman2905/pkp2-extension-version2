---
const { gallery } = Astro.props;

// Filter khusus gambar yang kategorinya 'facility'
const facilities = gallery.filter(item => item.kategori === 'facility');
---
<section id="fasilitas" class="py-16 bg-white">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold mb-10 text-gray-800">Fasilitas Premium</h2>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {facilities.map(item => (
        <div class="group relative overflow-hidden rounded-xl shadow-sm aspect-square">
          <img 
            src={item.image_url} 
            alt={item.caption || 'Fasilitas'} 
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            loading="lazy"
          />
          <!-- Efek gradient untuk teks caption di bawah gambar -->
          <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/80 to-transparent p-4 text-left">
            <p class="text-white font-medium text-sm md:text-base">{item.caption}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
