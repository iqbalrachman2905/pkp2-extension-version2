---
const { content } = Astro.props;
---

{content.maps_link && (
  <section id="lokasi" class="maps-section">
    <div class="container">
      <div class="maps-card">
        <div class="maps-text">
          <span class="eyebrow">Lokasi</span>
          <h2>Cek Lokasi Lengkap di Google Maps</h2>
          <p>Lihat rute, jarak, dan kondisi sekitar cluster langsung dari Google Maps.</p>
        </div>
        <a href={content.maps_link} target="_blank" rel="noopener noreferrer" class="maps-btn">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
          </svg>
          Buka di Google Maps
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .maps-section {
    padding-block: var(--space-lg);
  }
  .maps-card {
    background: var(--color-paper);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gold);
    margin-bottom: 6px;
  }
  .maps-text h2 {
    font-size: 1.4rem;
    margin-bottom: 6px;
  }
  .maps-text p {
    color: var(--color-navy-soft);
    font-size: 0.92rem;
  }
  .maps-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-navy);
    color: var(--color-white);
    font-weight: 600;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .maps-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
