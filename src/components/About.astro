---
import { Image } from 'astro:assets';

const { content, gallery } = Astro.props;
const imageTentang = gallery.find(item => item.kategori === 'tentang' && item.thumbnail_url);
---

<section id="tentang" class="tentang-section">
  <div class="container">
    <div class="banner">
      {imageTentang ? (
        <Image
          src={imageTentang.thumbnail_url}
          inferSize
          alt="Tentang PKP2 Extension"
          widths={[480, 900, 1400]}
          sizes="100vw"
          format="webp"
          quality={75}
          loading="lazy"
          class="banner-img"
        />
      ) : (
        <div class="banner-fallback">Gambar Tentang belum tersedia</div>
      )}

      <div class="banner-overlay"></div>

      <div class="banner-content">
        <span class="badge">Sejak pertengahan 2010-an</span>
        <h2>Perjalanan Puri Kencana Permai</h2>
        <p>{content.about_description}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .tentang-section {
    padding-block: var(--space-xl);
    background: var(--color-white, #fff);
  }
  .banner {
    position: relative;
    width: 100%;
    min-height: 500px;
    border-radius: var(--radius-lg, 28px);
    overflow: hidden;
    box-shadow: var(--shadow-card, 0 10px 30px rgba(0,0,0,0.15));
    display: flex;
    align-items: center;
  }
  .banner :global(.banner-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-fallback {
    position: absolute;
    inset: 0;
    background: var(--color-bg-grey, #e5e7eb);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
  }
  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(15,23,42,0.95), rgba(15,23,42,0.75) 45%, rgba(15,23,42,0.15));
  }
  .banner-content {
    position: relative;
    z-index: 1;
    padding: 40px 32px;
    max-width: 640px;
  }
  .badge {
    display: inline-block;
    background: var(--color-gold, #2563eb);
    color: #fff;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .banner-content h2 {
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
  }
  .banner-content p {
    color: rgba(255,255,255,0.9);
    line-height: 1.7;
    font-size: 0.95rem;
    white-space: pre-wrap;
  }

  @media (max-width: 767px) {
    .banner {
      min-height: 560px;
    }
    .banner-content {
      padding: 28px 20px;
      max-width: 100%;
    }
    .banner-overlay {
      background: linear-gradient(to top, rgba(15,23,42,0.95), rgba(15,23,42,0.6) 55%, rgba(15,23,42,0.15));
    }
  }
</style>
